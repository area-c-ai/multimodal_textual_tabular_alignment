# Copy to comparison/.env and fill in. Never commit .env.

# --- OMOP database (Postgres) ---------------------------------------------
PGHOST=127.0.0.1
PGPORT=54320
PGUSER=postgres
PGPASSWORD=
PGDATABASE=OHDSI-CDM_V54

# --- vLLM (OpenAI-compatible) ----------------------------------------------
# Base URL of the vLLM server WITHOUT a trailing /v1
# (the runner appends /v1/chat/completions to the local proxy address).
VLLM_UPSTREAM=
# Must match the server's --served-model-name.
VLLM_MODEL=qwen3.8-27b
# Bearer token; the owner's other repo keeps it in agents/.env.
VLLM_API_KEY=
